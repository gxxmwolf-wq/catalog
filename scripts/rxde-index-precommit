#!/bin/sh
# RXDE: refresh the static product navigation only when product HTML pages are staged.
# This hook runs locally on Git commit, not on site visitors or price updates.
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! git diff --cached --name-only --diff-filter=ACDMR | grep -Eq '^p/[0-9]{8}/index\.html$'; then
  exit 0
fi
if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
  py -3 build_catalog_index.py .
elif command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
  python build_catalog_index.py .
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
  python3 build_catalog_index.py .
else
  echo 'RXDE SEO: Python 3 not found, commit stopped to avoid stale index.' >&2
  exit 1
fi
# Include generated additions and removals. Product pages themselves are untouched.
git add -A -- p/index.html sitemap.xml
# Stage generated letter pages only (avoid staging unrelated user edits under p/).
git ls-files --cached --others --exclude-standard -- p/ | grep -E '^p/(ru-[0-9]+|en-[a-z]|num|other)(-[0-9]+)?\.html$' | while IFS= read -r file; do
  git add -A -- "$file"
done
printf 'RXDE SEO: product index and sitemap automatically staged.\n'
